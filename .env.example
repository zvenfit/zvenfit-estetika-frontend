# Скопируйте в .env.development для локальной разработки (файл исключён из Git).
# Автоматически его читают только сборка и мок-сервер. Команды деплоя получают
# реквизиты из текущего окружения shell.

# --- Сборка (npm run build / dev) ---
LEAD_API_URL=
NODE_ENV=development
ASSET_VERSION=dev
SITE_URL=https://estetika.zvenfit.ru
YANDEX_METRIKA_ID=

# --- Бакет сайта (CI загружает полный dist/) ---
YC_S3_BUCKET=zvenfit-estetika-frontend

# --- CDN-бакет ассетов (вручную: npm run upload:assets) ---
YC_ASSETS_BUCKET=zvenfit-estetika
# YC_ASSETS_PREFIX=   # необязательная подпапка; пустое значение означает корень бакета

# --- Реквизиты загрузчика ассетов (npm run upload:assets) ---
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=

# npm run deploy:yc использует имена AWS CLI для статического ключа того же типа:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Локальный деплой облачной функции (необязательно) ---
YC_FOLDER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALLOWED_ORIGINS=https://estetika.zvenfit.ru,http://localhost:4173,http://127.0.0.1:4173
