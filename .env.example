# Скопируйте в .env.development для локальной разработки (файл исключён из Git).
# Автоматически его читают только сборка и мок-сервер. Команды деплоя получают
# реквизиты из текущего окружения shell.

# --- Сборка (npm run build / dev) ---
LEAD_API_URL=
NODE_ENV=development
ASSET_VERSION=dev
SITE_URL=https://estetika.zvenfit.ru
YANDEX_METRIKA_ID=

# --- Бакет сайта (CI загружает полный dist/) ---
YC_S3_BUCKET=zvenfit-estetika-frontend

# --- CDN-бакет ассетов ---
YC_ASSETS_BUCKET=zvenfit-estetika

# npm run deploy:yc использует имена AWS CLI; предпочтительны короткоживущие credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Локальный деплой облачной функции (необязательно) ---
YC_FOLDER_ID=
# CI использует четыре разные identity; локально обычно нужны только runtime и текущая yc-сессия.
YC_DEPLOY_SERVICE_ACCOUNT_ID=
YC_YDB_VERIFY_SERVICE_ACCOUNT_ID=
YC_STORAGE_SERVICE_ACCOUNT_ID=
YC_LEAD_SERVICE_ACCOUNT_ID=
YDB_DATABASE_ID=
YDB_DATABASE_NAME=zvenfit-estetika-leads
YDB_SUBMISSIONS_TABLE=submissions
YDB_SUBSCRIPTIONS_TABLE=subscriptions
YDB_RATE_LIMITS_TABLE=submission_rate_limits
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=600
MAX_TELEGRAM_ATTEMPTS=12
TELEGRAM_RETRY_BATCH_SIZE=5
TELEGRAM_TIMEOUT_MS=15000
YC_LEAD_TIMEOUT=120s
YDB_QUERY_TIMEOUT_MS=10000
YDB_SLOW_OPERATION_MS=3000
YDB_SESSION_POOL_SIZE=5
LOG_LEVEL=info
MONIUM_METRICS_ENABLED=false
MONIUM_PROJECT=
MONIUM_CLUSTER=default
MONIUM_SERVICE=zvenfit-estetika-frontend
MONIUM_APPLICATION=zvenfit-estetika-frontend
MONIUM_ENVIRONMENT=production
MONIUM_COMPONENT=zvenfit-estetika-telegram-lead
MONIUM_RESOURCE_ID=zvenfit-estetika-telegram-lead
MONIUM_METRICS_TIMEOUT_MS=1000
MONIUM_API_KEY=
# Для локального вызова настоящего handler; токен IAM короткоживущий, не коммитьте его.
YDB_CONNECTION_STRING=
YDB_ACCESS_TOKEN_CREDENTIALS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEAD_RATE_LIMIT_SECRET=
ALLOWED_ORIGINS=https://estetika.zvenfit.ru,http://localhost:4173,http://127.0.0.1:4173
