# Copy to .env.development for local dev (gitignored).
# Only the build and mock server load this file automatically. Deploy commands
# read credentials from the current shell environment.

# --- Build (npm run build / dev) ---
LEAD_API_URL=
NODE_ENV=development
ASSET_VERSION=dev
SITE_URL=https://estetika.zvenfit.ru
YANDEX_METRIKA_ID=

# --- Site bucket (CI deploys full dist/) ---
YC_S3_BUCKET=zvenfit-estetika-frontend

# --- Assets CDN bucket (manual: npm run upload:assets) ---
YC_ASSETS_BUCKET=zvenfit-estetika
# YC_ASSETS_PREFIX=   # optional subfolder; leave empty for bucket root

# --- Assets uploader credentials (npm run upload:assets) ---
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=

# npm run deploy:yc uses the AWS CLI names for the same type of static key:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Local deploy Cloud Function (optional) ---
YC_FOLDER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALLOWED_ORIGINS=https://estetika.zvenfit.ru,http://localhost:4173,http://127.0.0.1:4173
